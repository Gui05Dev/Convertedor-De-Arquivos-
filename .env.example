# Configuração do docker-compose (homologação). Copie para `.env` e preencha.
# O .env NÃO vai para o git. Proteja o arquivo:  chmod 600 .env
# Os valores abaixo são EXEMPLOS — nenhum deles é credencial real.

# ── Endereço público (o que o usuário digita no navegador) ──
# Atrás do proxy HTTPS corporativo. Precisa bater com o "Valid redirect URI" do
# client no Keycloak: <PUBLIC_URL>/oauth2/callback
PUBLIC_URL=https://conversor-hml.exemplo.copacol.intra

# Porta publicada no host para o proxy reverso alcançar o nginx.
# 127.0.0.1 = só a própria máquina (proxy reverso no mesmo servidor).
# Se o proxy estiver em outra máquina, use o IP da interface interna e restrinja
# no firewall para aceitar só o proxy.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# ── Keycloak (OIDC) ──
# Issuer do realm, exatamente como aparece no campo "issuer" de
# <OIDC_ISSUER>/.well-known/openid-configuration
OIDC_ISSUER=https://sso.exemplo.copacol.intra/realms/copacol
# Endereço do realm usado PELOS CONTAINERS (troca de código, chaves, logout).
# Deixe vazio para usar OIDC_ISSUER. Só muda quando o Keycloak tem outro endereço
# dentro da rede Docker (ex.: Keycloak de teste: http://keycloak:8180/realms/copacol).
OIDC_INTERNAL_URL=
# Client confidencial do Conversor (ver README > Keycloak).
OIDC_CLIENT_ID=conversor
OIDC_CLIENT_SECRET=troque-pelo-segredo-do-client
# Papel de realm exigido para usar o conversor (vazio = qualquer usuário do realm).
OIDC_REQUIRED_ROLE=conversor-usuario

# ── Sessão (oauth2-proxy) ──
# 32 bytes aleatórios em base64 url-safe. Gere com:
#   python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_COOKIE_SECRET=gere-um-valor-com-o-comando-acima
# Com HTTPS (homologação/produção): __Host-conversor e true.
# Só para teste local em http://localhost: _conversor_sessao e false.
OAUTH2_COOKIE_NAME=__Host-conversor
OAUTH2_COOKIE_SECURE=true
OAUTH2_COOKIE_EXPIRE=8h

# ── Recursos ──
BACKEND_CPUS=2
BACKEND_MEMORY=3g
# Corpo máximo de um envio no nginx (>= MAX_TOTAL_UPLOAD_MB do backend/.env).
MAX_UPLOAD_SIZE=210m

# Sub-rede da rede "edge" (nginx + oauth2-proxy). Mude se colidir com a rede local.
EDGE_SUBNET=172.30.10.0/24

# Versão das imagens geradas (tag local).
APP_VERSION=3.0.0

# ── Somente com --profile keycloak-local (Keycloak de teste embutido) ──
# Para esse modo use também:
#   PUBLIC_URL=http://localhost:8080
#   OIDC_ISSUER=http://keycloak.localhost:8180/realms/copacol
#   OAUTH2_COOKIE_NAME=_conversor_sessao
#   OAUTH2_COOKIE_SECURE=false
KC_LOCAL_ADMIN_PASSWORD=troque-esta-senha-de-admin-local
# Senha dos usuários sintéticos alice e bob do realm de teste.
KC_LOCAL_TEST_PASSWORD=troque-esta-senha-de-teste
