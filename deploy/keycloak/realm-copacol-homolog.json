{
  "realm": "copacol",
  "displayName": "Copacol (homologação local — SÓ PARA TESTE)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "roles": {
    "realm": [
      { "name": "conversor-usuario", "description": "Pode usar o Conversor de Arquivos" }
    ]
  },
  "clients": [
    {
      "clientId": "conversor",
      "name": "Conversor de Arquivos",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_CONVERSOR_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${KC_CONVERSOR_PUBLIC_URL}/oauth2/callback"],
      "webOrigins": ["${KC_CONVERSOR_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_CONVERSOR_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "audience-conversor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "conversor",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Teste",
      "email": "alice@exemplo.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_PASSWORD}", "temporary": false }],
      "realmRoles": ["default-roles-copacol", "conversor-usuario"]
    },
    {
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Teste",
      "email": "bob@exemplo.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KC_TEST_PASSWORD}", "temporary": false }],
      "realmRoles": ["default-roles-copacol", "conversor-usuario"]
    }
  ]
}
