# Copie para .env e ajuste. O .env NÃO vai pro git (ver .gitignore).
# Toda credencial/segredo do sistema mora aqui — o frontend nunca recebe nada disso.

# Porta HTTP do backend.
PORT=3000

# development | production
NODE_ENV=production

# Limites de upload. maxFileSizeMb vale por arquivo; maxFiles vale por requisição
# (juntar PDFs e imagens->PDF aceitam vários).
MAX_FILE_SIZE_MB=100
MAX_FILES=20

# Tempo máximo de uma conversão externa (LibreOffice/pdf2docx) antes de ser morta -> HTTP 504.
CONVERT_TIMEOUT_MS=90000

# Conversões externas simultâneas. Cada uma sobe um processo pesado de CPU/RAM;
# acima disso a requisição recebe 503 em vez de derrubar o container.
MAX_CONCURRENT_CONVERSIONS=2

# Binários usados pelas conversões de Office. Os defaults valem dentro do Docker.
LIBREOFFICE_BIN=/usr/bin/soffice
PYTHON_BIN=python3

# Deixe VAZIO no deploy padrão (nginx do frontend proxia /api -> mesma origem, sem CORS).
# Preencha com a origem exata do frontend só se expor o backend direto, ex.:
# CORS_ORIGIN=https://ferramentas.copacol.com.br
CORS_ORIGIN=
