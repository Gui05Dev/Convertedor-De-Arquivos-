# Parâmetros do backend. Copie para backend/.env e ajuste.
# No docker-compose, as variáveis de autenticação (AUTH_MODE, OIDC_*) e DATA_DIR são
# definidas pelo próprio compose a partir do .env da raiz — não repita aqui.

NODE_ENV=production
LOG_LEVEL=info

# ── Retenção (minutos) ──
# Originais: 0 = apagados assim que o processamento termina (recomendado).
ORIGINAL_RETENTION_MINUTES=0
# Resultados: prazo para o usuário baixar; depois são apagados.
RESULT_RETENTION_MINUTES=60
# Intervalo da limpeza automática (segundos).
CLEANUP_INTERVAL_SECONDS=60

# ── Limites de envio ──
MAX_FILE_SIZE_MB=100
MAX_FILES=20
MAX_TOTAL_UPLOAD_MB=200
MAX_PDF_PAGES=2000
# Pixels por imagem (barra "bombas" de descompressão). 80 milhões ≈ 10000 x 8000.
MAX_IMAGE_PIXELS=80000000

# ── Limites de execução ──
# Tempo máximo de um trabalho; estourou, o conversor é morto e o usuário é avisado.
JOB_TIMEOUT_MS=120000
# Trabalhos processando ao mesmo tempo (cada um pode subir um LibreOffice, ~300-600 MB).
MAX_CONCURRENT_JOBS=2
# Trabalhos aguardando na fila; acima disso o envio recebe "servidor ocupado".
MAX_QUEUED_JOBS=20
# Trabalhos não concluídos por usuário.
MAX_ACTIVE_JOBS_PER_USER=3
# Memória do worker que roda pdf-lib/sharp (MB).
WORKER_MAX_HEAP_MB=1024
# Maior arquivo que um conversor externo pode gravar (MB).
MAX_OUTPUT_MB=500

# ── Ferramentas opcionais ──
# PDF -> Word usa PyMuPDF (AGPL-3.0). Desligue se a análise de licença não aprovar.
ENABLE_PDF_TO_DOCX=true

# ── Só para desenvolvimento local, fora do Docker (npm run dev) ──
# AUTH_MODE=dev
# AUTH_DEV_USER=dev
# DATA_DIR=./data
