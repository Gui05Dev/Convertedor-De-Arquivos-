# Servidor do frontend. Duas funções:
#   1. entregar o build da SPA (saída do `vite build`);
#   2. proxiar /api/ pro backend, para a página usar caminho relativo.
#
# É isso que permite ao navegador nunca conhecer o endereço do backend: ele só fala
# com esta origem. Consequências práticas — sem CORS, sem URL de API embutida no
# bundle, e o backend pode ficar numa rede interna sem porta publicada.
#
# ${VARIAVEIS} são preenchidas no start pelo entrypoint do nginx (envsubst),
# a partir do ambiente definido no docker-compose.yml.

server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Precisa acompanhar MAX_FILE_SIZE_MB do backend: se for menor, o nginx corta o
    # upload com 413 antes de chegar lá e o limite real passa a ser este, não o do .env.
    client_max_body_size ${MAX_UPLOAD_SIZE};

    # A página não busca nada fora desta origem — o CSP transforma isso em regra
    # imposta pelo navegador, não só em convenção. 'unsafe-inline' em script-src cobre
    # o script de tema no <head> do index.html (o bundle do Vite entra por <script src>).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;

    # DNS interno do Docker (a variável é exportada pelo próprio entrypoint do nginx).
    # Sem isto, o nginx resolveria "backend" uma única vez no boot e cravaria o IP: se o
    # container do backend reiniciasse com outro IP, todo /api viraria 502 até o nginx
    # ser reiniciado também. Com resolver + upstream em variável, a resolução é a cada 10s.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        # Upstream numa variável é o que força a resolução em tempo de execução; aí o
        # nginx passa a exigir a URI explícita, daí o $request_uri.
        set $backend_origin ${BACKEND_ORIGIN};
        proxy_pass $backend_origin$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Repassa o upload conforme chega, em vez de guardar o arquivo inteiro em disco
        # antes de acionar o backend — o progresso de envio na tela fica real.
        proxy_request_buffering off;

        # Conversões de Office levam dezenas de segundos; o default de 60s do nginx
        # cortaria a conexão antes do backend responder.
        proxy_connect_timeout ${PROXY_TIMEOUT};
        proxy_send_timeout    ${PROXY_TIMEOUT};
        proxy_read_timeout    ${PROXY_TIMEOUT};
    }

    # O cache é controlado com `expires`, e não com `add_header Cache-Control`, de
    # propósito: qualquer add_header dentro de um location descarta TODOS os add_header
    # herdados do server — os headers de segurança acima sumiriam justamente nas rotas
    # que entregam a página. `expires` gera o Cache-Control sem disparar essa regra.

    # O Vite põe hash de conteúdo no nome de tudo que sai em /assets/: um deploy novo
    # gera nomes novos, então esses arquivos podem ser cacheados pra sempre.
    location /assets/ {
        expires 1y;
        access_log off;
    }

    # Fontes e imagens vêm de public/ e não levam hash, daí o prazo mais curto.
    location ~* \.(woff2|png|svg|jpg|jpeg|ico)$ {
        expires 30d;
    }

    # Fallback de SPA: qualquer rota desconhecida devolve o index.html e quem decide o
    # que renderizar é o React. Não afeta /api/ nem os arquivos acima, que são locations
    # mais específicos e têm precedência.
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
